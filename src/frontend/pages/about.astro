---
import Icon, { type IconName } from '#frontend/components/icon.svelte'
import Logo from '#frontend/components/logo.svelte'
import ThemeToggle from '#frontend/components/theme-toggle.svelte'
import Base from '#frontend/layouts/base.astro'

const STEPS = [
	{
		title: 'Скачайте поручение из Логистики',
		text: 'Комплект документов в zip или отдельный XML поручения — файл вида ON_POREXPKLT_*.xml.',
	},
	{
		title: 'Загрузите его и дозаполните пропуски',
		text: 'Обычно не хватает трёх вещей: ИНН перевозчика, номера заказа и адреса, которого нет в ФИАС. Незаполненное подсвечено, а список пропусков всё время перед глазами.',
	},
	{
		title: 'Скачайте XML и отправьте в Логистике',
		text: 'Файл в формате ФНС 5.01 и кодировке windows-1251 — ровно такой, какой принимает Логистика.',
	},
]

const AUTO: Array<{ icon: IconName; title: string; text: string }> = [
	{
		icon: 'package',
		title: 'Стороны и груз',
		text: 'экспедитор, грузоотправитель, наименование, места и вес — из поручения',
	},
	{
		icon: 'building',
		title: 'Реквизиты перевозчика',
		text: 'по ИНН из ЕГРЮЛ и ЕГРИП: наименование, КПП, ОГРН, адрес',
	},
	{
		icon: 'map-pin',
		title: 'Адреса',
		text: 'с кодами ФИАС; если в поручении адрес строкой, он сразу попадает в поиск',
	},
	{ icon: 'calendar', title: 'Даты', text: 'подача и выгрузка — первые даты отгрузки и доставки из поручения' },
	{ icon: 'user-pen', title: 'Подписант', text: 'из титула экспедитора, если он есть в комплекте' },
	{ icon: 'boxes', title: 'Вид тары', text: 'поиском по справочнику, по названию или коду' },
]
---

<Base
	title="Как это работает"
	description="Логист собирает заказ-заявку перевозчику из поручения экспедитору: что делает сервис, кому он нужен и как им пользоваться."
>
	<div class="about">
		<header class="about__header">
			<div class="container about__header-inner">
				<Logo href="/" label="Логист — к заявке" />
				<ThemeToggle client:load />
			</div>
		</header>

		<main class="container about__main">
			<section class="about__hero">
				<p class="about__kicker">Для экспедиторов в Контур.Логистике</p>
				<h1 class="about__title">Заявка перевозчику из&nbsp;поручения — за&nbsp;пару минут</h1>
				<p class="about__lead">
					Логист берёт электронное поручение экспедитору и&nbsp;собирает из&nbsp;него заказ-заявку
					перевозчику. Всё, что есть в&nbsp;поручении и&nbsp;в&nbsp;госреестрах, подставляется само: остаётся
					дозаполнить пару полей и&nbsp;скачать готовый XML.
				</p>
				<div class="about__actions">
					<a href="/" class="about__button about__button--primary">
						Сделать заявку
						<Icon name="arrow-right" />
					</a>
					<a href="/demo/poruchenie-primer.zip" class="about__button" download>
						<Icon name="download" />
						Скачать пример поручения
					</a>
				</div>
			</section>

			<section class="about__card">
				<h2 class="about__heading">
					<Icon name="lightbulb" size={18} class="about__heading-icon" />
					Зачем это нужно
				</h2>
				<p>
					Поручение экспедитору (КНД 1110486) и&nbsp;заказ-заявка перевозчику (КНД 1110361)&nbsp;— разные
					документы, но данные в&nbsp;них во&nbsp;многом общие: стороны, груз, адреса, даты. Заявку всё равно
					приходится заполнять заново&nbsp;— больше тридцати полей руками, и&nbsp;одна опечатка в&nbsp;ИНН или
					адресе возвращает документ обратно.
				</p>
				<p>
					Логист переносит всё совпадающее из&nbsp;поручения и&nbsp;заранее показывает, чего
					не&nbsp;хватает,&nbsp;— до того как файл уйдёт перевозчику.
				</p>
			</section>

			<section class="about__card">
				<h2 class="about__heading">
					<Icon name="list-checks" size={18} class="about__heading-icon" />
					Как пользоваться
				</h2>
				<ol class="about__steps">
					{STEPS.map((step, index) => (
						<li class="about__step">
							<span class="about__number">{index + 1}</span>
							<div class="about__step-text">
								<h3 class="about__step-title">{step.title}</h3>
								<p class="about__muted">{step.text}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="about__card">
				<h2 class="about__heading">
					<Icon name="sparkles" size={18} class="about__heading-icon" />
					Что подставляется само
				</h2>
				<ul class="about__auto">
					{AUTO.map((item) => (
						<li class="about__auto-item">
							<h3 class="about__step-title about__step-title--icon">
								<Icon name={item.icon} class="about__auto-icon" />
								{item.title}
							</h3>
							<p class="about__muted">{item.text}</p>
						</li>
					))}
				</ul>
			</section>

			<section class="about__card">
				<h2 class="about__heading">
					<Icon name="shield-check" size={18} class="about__heading-icon" />
					Что с данными
				</h2>
				<p>
					Поручение нигде не&nbsp;хранится: сервер разбирает файл, отдаёт данные в&nbsp;браузер и&nbsp;сразу
					о&nbsp;них забывает. Для поиска реквизитов и&nbsp;адресов ИНН и&nbsp;строка адреса уходят
					в&nbsp;сервис DaData.
				</p>
			</section>

			<p class="about__note">
				Логист&nbsp;— независимый сервис, он не&nbsp;связан с&nbsp;компанией «Контур» и&nbsp;не&nbsp;является её
				продуктом. Контур.Логистика и&nbsp;Диадок&nbsp;— сервисы и&nbsp;товарные знаки их правообладателя.
			</p>
		</main>
	</div>
</Base>

<style>
	.about {
		display: flex;
		flex: 1;
		flex-direction: column;

		&__header {
			border-bottom: 1px solid var(--border);
		}

		&__header-inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			height: 4.25rem;
		}

		&__main {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			padding-block: 2.5rem 4rem;
		}

		&__hero {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding-block: 1rem 1.5rem;
		}

		&__kicker {
			font-size: 0.75rem;
			font-weight: 500;
			color: var(--brand-text);
			text-transform: uppercase;
			letter-spacing: 0.06em;
		}

		&__title {
			font-size: 2.25rem;
			font-weight: 700;
			line-height: 1.15;
			text-wrap: balance;
			letter-spacing: -0.03em;

			@media (--below-sm) {
				font-size: 1.75rem;
			}
		}

		&__lead {
			max-width: 38rem;
			font-size: 1.0625rem;
			color: var(--muted);
		}

		&__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 0.75rem;
		}

		&__button {
			display: inline-flex;
			gap: 0.5rem;
			align-items: center;
			height: 2.75rem;
			padding: 0 1.25rem;
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			font-weight: 500;
			color: var(--fg);
			text-decoration: none;
			background: var(--bg);
			box-shadow: var(--shadow-sm);
			transition: background-color 0.15s;

			@media (--reduced-motion) {
				transition: none;
			}

			&:hover {
				background: var(--surface);
			}

			&:focus-visible {
				outline: none;
				box-shadow: 0 0 0 3px var(--ring);
			}

			&--primary {
				border-color: transparent;
				color: var(--primary-fg);
				background: var(--primary);

				&:hover {
					background: color-mix(in srgb, var(--primary) 88%, black);
				}
			}
		}

		/* Островок — как карточки мастера: рамка, лёгкая тень, свой заголовок. */
		&__card {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1.5rem;
			border: 1px solid var(--border);
			border-radius: var(--radius);
			background: var(--bg);
			box-shadow: var(--shadow-sm);

			@media (--below-sm) {
				padding: 1.125rem;
			}
		}

		&__heading {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			font-size: 1.125rem;
			font-weight: 650;
			letter-spacing: -0.015em;
		}

		&__steps {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			margin: 0.25rem 0 0;
			padding: 0;
			list-style: none;
		}

		&__step {
			display: flex;
			gap: 1rem;
			align-items: flex-start;
		}

		/* Номер ростом в две строки — заголовок шага и начало пояснения. */
		&__number {
			display: flex;
			flex-shrink: 0;
			align-items: center;
			justify-content: center;
			width: 3rem;
			height: 3rem;
			border-radius: 50%;
			font-size: 1.375rem;
			font-weight: 700;
			font-variant-numeric: tabular-nums;
			color: var(--brand-text);
			background: var(--brand-soft);
		}

		&__step-text {
			display: flex;
			flex-direction: column;
			gap: 0.125rem;
			padding-top: 0.125rem;
		}

		&__step-title {
			font-size: 0.9375rem;
			font-weight: 600;
		}

		&__muted {
			color: var(--muted);
		}

		&__auto {
			display: grid;
			gap: 1rem 1.5rem;
			margin-top: 0.25rem;

			@media (--sm) {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		&__auto-item {
			display: flex;
			flex-direction: column;
			gap: 0.125rem;
		}

		&__step-title--icon {
			display: flex;
			gap: 0.5rem;
			align-items: center;
		}

		/* Иконки в тон бренду, как у заголовков карточек мастера. */
		:global(.about__heading-icon),
		:global(.about__auto-icon) {
			flex-shrink: 0;
			color: var(--brand-text);
		}

		&__note {
			margin-top: 1rem;
			font-size: 0.8125rem;
			color: var(--muted);
		}
	}
</style>
