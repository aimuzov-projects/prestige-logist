---
import NotFound from '@aimuzov-projects/infra-site-kit/not-found.astro'
import Base from '#frontend/layouts/base.astro'
---

<Base title="Страница не найдена" description="Такой страницы на сайте нет." index={false}>
	<div class="missing">
		<main class="missing__main">
			<div class="container">
				<NotFound />
			</div>
		</main>
	</div>
</Base>

<style>
	.missing {
		/* --brand-text, а не --primary: тёмная --primary на тёмном фоне не дотягивает до AA. */
		--not-found-accent: var(--brand-text);
		--not-found-muted: var(--muted);
		--not-found-radius: var(--radius-sm);

		display: flex;
		flex: 1;
		flex-direction: column;

		&__main {
			display: grid;
			flex: 1;
			align-items: center;
			padding-block: 3rem 6rem;
		}

		/* Цифры серым фоном, как было, а лицо между ними -- фирменным цветом. */
		& :global(.not-found .not-found__code) {
			color: color-mix(in oklch, var(--fg) 12%, transparent);
		}

		/* Главная кнопка залита --primary, как кнопки в остальном интерфейсе. */
		& :global(.not-found .not-found__action--primary) {
			border-color: var(--primary);
			color: var(--primary-fg);
			background: var(--primary);

			&:hover {
				background: color-mix(in srgb, var(--primary) 88%, black);
			}
		}
	}
</style>
