---
import Base from '#frontend/layouts/base.astro'
---

<Base title="Страница не найдена" description="Такой страницы на сайте нет." index={false}>
	<div class="missing">
		<main class="missing__main">
			<div class="container missing__body">
				<!-- Иконки lucide (route-off, arrow-left) вписаны как есть: Svelte-версия в Astro не типизируется. -->
				<span class="missing__icon">
					<svg class="missing__glyph" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
						<circle cx="6" cy="19" r="3"></circle>
						<path d="M9 19h8.5c.4 0 .9-.1 1.3-.2"></path>
						<path d="M5.2 5.2A3.5 3.53 0 0 0 6.5 12H12"></path>
						<path d="m2 2 20 20"></path>
						<path d="M21 15.3a3.5 3.5 0 0 0-3.3-3.3"></path>
						<path d="M15 5h-4.3"></path>
						<circle cx="18" cy="5" r="3"></circle>
					</svg>
				</span>
				<p class="missing__code" aria-hidden="true">
					404
				</p>
				<h1 class="missing__title">Такой страницы нет</h1>
				<p class="missing__text">Возможно, ссылка устарела или в ней опечатка.</p>
				<a href="/" class="missing__home">
					<svg class="missing__glyph" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<path d="m12 19-7-7 7-7"></path>
						<path d="M19 12H5"></path>
					</svg>
					На главную
				</a>
			</div>
		</main>
	</div>
</Base>

<style>
	.missing {
		display: flex;
		flex: 1;
		flex-direction: column;

		/* Штрих как у lucide-иконок в остальном интерфейсе. */
		&__glyph {
			fill: none;
			stroke: currentColor;
			stroke-linecap: round;
			stroke-linejoin: round;
			stroke-width: 2;
		}

		&__main {
			display: grid;
			flex: 1;
			align-items: center;
			padding-block: 3rem 6rem;
		}

		&__body {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		&__icon {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 4rem;
			height: 4rem;
			margin-bottom: 1.5rem;
			border-radius: var(--radius);
			color: var(--brand-text);
			background: var(--brand-soft);
		}

		/* Крупная цифра — фон для заголовка, а не его замена: читалки её пропускают. */
		&__code {
			font-size: 4.5rem;
			font-weight: 700;
			font-variant-numeric: tabular-nums;
			line-height: 1;
			color: color-mix(in oklch, var(--fg) 12%, transparent);
			letter-spacing: -0.04em;
		}

		&__title {
			margin-top: 0.75rem;
			font-size: 1.75rem;
			font-weight: 650;
			line-height: 1.2;
			letter-spacing: -0.025em;
		}

		&__text {
			margin-top: 0.5rem;
			color: var(--muted);
		}

		&__home {
			display: inline-flex;
			gap: 0.5rem;
			align-items: center;
			height: 2.75rem;
			margin-top: 2rem;
			padding: 0 1.5rem;
			border-radius: var(--radius-sm);
			font-weight: 500;
			color: var(--primary-fg);
			text-decoration: none;
			background: var(--primary);
			transition: background-color 0.15s;

			@media (--reduced-motion) {
				transition: none;
			}

			&:hover {
				background: color-mix(in srgb, var(--primary) 88%, black);
			}

			&:focus-visible {
				outline: none;
				box-shadow: 0 0 0 3px var(--ring);
			}
		}
	}
</style>
