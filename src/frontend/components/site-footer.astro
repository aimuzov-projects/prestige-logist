---
import Credit from '@aimuzov-projects/infra-site-kit/credit.astro'
---

<footer class="footer">
	<div class="container footer__inner">
		<Credit repo="https://github.com/aimuzov-projects/prestige-logist" />
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--border);
		font-size: 0.8125rem;
		color: var(--muted);

		&__inner {
			/* Ссылки подписи из infra-site-kit при наведении берут цвет выделенного текста. */
			--credit-hover: var(--selected-text);

			padding-block: 1.25rem;
		}
	}
</style>
