{
	"name": "prestige-logist",
	"type": "module",
	"changelog": true,
	"version": "1.1.0",
	"private": true,
	"description": "Конвертер электронного поручения экспедитору (КНД 1110486) в заказ-заявку на перевозку груза (КНД 1110361)",
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"api": "node --watch --env-file-if-exists=.env src/backend/server.ts"
	},
	"dependencies": {
		"adm-zip": "0.5.16",
		"fast-xml-parser": "4.5.3",
		"iconv-lite": "0.6.3",
		"lucide-static": "1.48.0"
	},
	"devDependencies": {
		"@aimuzov-projects/infra-site-kit": "github:aimuzov-projects/infra-site-kit#v1.13.0",
		"@astrojs/check": "0.9.10",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@csstools/postcss-global-data": "4.0.0",
		"@fontsource-variable/inter": "5.3.0",
		"@lucide/svelte": "1.39.0",
		"@playwright/test": "1.64.0",
		"@types/adm-zip": "0.5.8",
		"@types/node": "26.6.5",
		"astro": "7.3.7",
		"oxlint": "1.87.0",
		"postcss-custom-media": "12.0.3",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"stylelint": "17.16.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#backend/*": "./src/backend/*",
		"#shared/*": "./src/shared/*"
	}
}
